# On macOS, copy to .wechat/wechat.env (ignored by Git), then chmod 600.
# Run from the repository: node scripts/wechat/cli.mjs sync
# The JS script loads .wechat/wechat.env automatically.
# Optional: set WECHAT_ENV_FILE to another private configuration file.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional absolute path to persistent, writable state storage.
# Omit to use this repository's .wechat/state directory.
# WECHAT_STATE_DIR=/absolute/path/to/blog-wechat-state
